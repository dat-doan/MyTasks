{
  "expo": {
    "name": "MyTasks",
    "slug": "MyTasks",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mytasks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.datdn.mytasks",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.datdn.mytasks",
      "googleServicesFile": "./firebase/google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "tasks",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-firebase/app/app.plugin.js",
      [
        "@react-native-firebase/messaging/app.plugin.js",
        {
          "installationIdEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d216224-3596-4bea-bbd0-0c4fa0222996"
      }
    },
    "owner": "datdn4"
  }
}
